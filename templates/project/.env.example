# Copy to .env (git-ignored). Every value can also be passed as a real environment variable, which is
# how a CI workflow supplies them; a variable that is already set is never replaced by this file.

# Which environment the run targets: one of the names in src/project.ts.
E2E_ENV=local

# Replaces one store's base URL in any environment: E2E_BASE_URL_<STORE CODE IN UPPER CASE>.
# E2E_BASE_URL_FR=https://shop.test/fr/

# The address of the staging site, read by the staging environment of src/project.ts.
# E2E_STAGING_URL=https://staging.example.com

# HTTP authentication in front of a site, when it has one.
E2E_HTTP_USER=
E2E_HTTP_PASSWORD=

# Appended to the browser's user agent so test traffic can be told apart in logs and analytics.
E2E_USER_AGENT_SUFFIX=

# "off" skips the tests tagged @search, for a site without a search service. Only an environment that
# declares itself searchServiceOptional accepts it; any other refuses the run.
# E2E_SEARCH_SERVICE=off

# Skips the check that the default store answers before the run - for a run that needs no site, such
# as Node-only module tests.
# E2E_PREFLIGHT=off

# The secret the shop recognises test orders by (@order tests): the value of test_order/proof_secret in
# the env.php of the environment this run targets, one per environment. Unset, @order tests are skipped.
# E2E_TEST_ORDER_SECRET=

# Keeps every test's video and screenshots, and writes the results the shared report and the summary
# e-mail are built from (allure-results/, reports/results.json).
# E2E_EVIDENCE=1

# Also runs every test in Safari's engine (projects desktop-safari and iphone). Needs
# `npx playwright install webkit` once.
# E2E_WEBKIT=1

# A per-store value a project records with perStoreValue('NAME', ...) is replaced by E2E_<NAME>_<STORE CODE>.
# E2E_CATEGORY_PATH_FR=catalog/category/view/id/12

# Set by CI systems; a run on CI retries failures twice and refuses a left-over test.only.
# CI=1

# Read by the report commands in CI (npx magento-e2e summary | report-gate):
# E2E_TRIGGER=manual        what started the run: deployment | nightly | manual
# E2E_COMMIT=               the commit under test
# E2E_REPORT_TITLE=         the words reports and e-mails are named with (default: Storefront checks)
# E2E_REPORT_NAME=          the name of the Allure report
# E2E_REPORT_URL=           where the published report is
# E2E_REPORT_USER=          the report's login name
# E2E_REPORT_PASSWORD=      the report's password; never written into any file the report ships
